{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "odigos-daskalou",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["VERSION"],
      "changelog-sections": [
        { "type": "feat", "section": "Νέα και αλλαγές" },
        { "type": "fix", "section": "Διορθώσεις" },
        { "type": "docs", "section": "Τεκμηρίωση", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "perf", "section": "Επιδόσεις", "hidden": true },
        { "type": "refactor", "section": "Αναδιάρθρωση", "hidden": true },
        { "type": "chore", "section": "Συντήρηση", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "test", "section": "Έλεγχοι", "hidden": true },
        { "type": "style", "section": "Μορφοποίηση", "hidden": true }
      ]
    }
  }
}
