{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "odigos-daskalou",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["VERSION"],
      "changelog-sections": [
        { "type": "feat", "section": "Περιεχόμενο και λειτουργίες" },
        { "type": "fix", "section": "Διορθώσεις" },
        { "type": "docs", "section": "Τεκμηρίωση" },
        { "type": "build", "section": "Build" },
        { "type": "chore", "scope": "assets", "section": "Φωτογραφίες και assets" },
        { "type": "perf", "section": "Επιδόσεις" },
        { "type": "refactor", "section": "Αναδιάρθρωση" },
        { "type": "chore", "section": "Συντήρηση", "hidden": true }
      ]
    }
  }
}
